{
	"root": true,
	"extends": [
	  "plugin:@wordpress/eslint-plugin/recommended-with-formatting",
	  "plugin:import/recommended",
	  "plugin:eslint-comments/recommended"
	],
	"env": {
	  "browser": true
	},
	"settings": {
	  // Provided at runtime by the `godam-layers` script (a webpack external).
	  "import/core-modules": [ "@godam/layers" ]
	},
	"rules": {
	  "jsdoc/check-indentation": "error",
	  "@wordpress/dependency-group": "error"
	},
	"overrides": [{
	  // Audience panels: enforce the text domain, and keep the data helpers free of DOM, d3 and React.
	  "files": [ "pages/analytics/components/Audience/**/*.js" ],
	  "rules": {
		"@wordpress/i18n-text-domain": [ "error", { "allowedTextDomain": "godam" } ]
	  }
	}, {
	  "files": [ "pages/analytics/components/Audience/audienceData.js" ],
	  "globals": { "d3": "off", "document": "off", "window": "off" },
	  "rules": {
		"no-restricted-imports": [ "error", { "patterns": [ "react", "react-dom", "react-dom/*", "@wordpress/element", "d3", "d3-*" ] } ],
		"no-restricted-globals": [ "error", "d3", "document", "window" ]
	  }
	}, {
	  "files": [
		"**/__tests__/**/*.js",
		"**/test/*.js",
		"**/?(*.)test.js",
		"tests/js/**/*.js"
	  ],
	  "extends": [
		"plugin:jest/recommended"
	  ],
	  "rules": {
		// Add stricter Jest rules here as the suite grows. `jest/recommended`
		// (the baseline @wordpress/scripts uses) avoids `jest/all`'s pedantic
		// rules and its `unbound-method`, which needs TS parser services this
		// JS project doesn't configure.
	  }
	}]
  }
  